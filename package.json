{
  "name": "orbit-desktop",
  "version": "1.2.7",
  "description": "Orbit Desktop client for Windows",
  "main": "src/main.js",
  "author": "Orbit",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbit.desktop",
    "productName": "Orbit",
    "artifactName": "Orbit Setup.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Convite do Orbit",
        "schemes": ["orbit"]
      }
    ],
    "win": {
      "icon": "src/assets/orbit.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kinglucas962",
        "repo": "orbit-desktop-releases",
        "releaseType": "release"
      }
    ]
  },
  "orbit": {
    "remoteUrl": "https://mini-discord-ashy.vercel.app",
    "updates": {
      "owner": "Kinglucas962",
      "repo": "orbit-desktop-releases"
    }
  }
}
